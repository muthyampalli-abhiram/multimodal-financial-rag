      "block_number": 4,
      "char_count": 318
    },
    "bbox": [
      100.46,
      187.38,
      548.47,
      229.83
    ]
  },
  {
    "element_id": "nvidia_test_subset_text_29",
    "doc_name": "nvidia_test_subset",
    "page_number": 2,
    "element_type": "text",
    "content": "◦\nNVIDIA AI Foundations, a set of cloud services that advance enterprise-level generative AI and enable \ncustomization across use cases in areas such as text, visual content, and biology",
    "metadata": {
      "block_number": 5,
      "char_count": 186
    },
    "bbox": [
      100.46,
      235.13,
      548.45,
      256.62
    ]
  },
